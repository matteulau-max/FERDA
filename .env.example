# --- Frontend (Vite, baked in at build time) ---
# The app's API endpoint. On Vercel this is the serverless function below.
VITE_API_URL=/api/exec

# --- Serverless API (Vercel project env vars, never exposed to the browser) ---
# Postgres connection string. With Supabase, use the *Transaction pooler*
# string (Project Settings → Database → Connection string → Transaction).
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional: which tournament /api/exec serves when no ?t=<slug> is passed.
# Unnecessary while only one tournament exists.
# DEFAULT_TOURNAMENT_SLUG=ferda-2026

# Optional: enables reading a course scorecard from a photo (Setup → Courses).
# Without it, that button returns a message saying it isn't configured and
# everything else works as before.
#
# MUST NOT be named VITE_ANYTHING. Anything with a VITE_ prefix is compiled
# into the browser bundle and readable by anyone who opens devtools; this key
# spends money.
# ANTHROPIC_API_KEY=sk-ant-...
